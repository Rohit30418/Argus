PORT=4100
MAX_CONCURRENT_SCANS=2
# 0 disables per-IP scan throttling. Production deployments should use a positive value.
ARGUS_SCAN_RATE_LIMIT_PER_HOUR=0

# Browser. ARGUS prefers installed Chrome/Chromium automatically.
ARGUS_HEADLESS=true
# ARGUS_BROWSER_CHANNEL=chrome
# ARGUS_BROWSER_EXECUTABLE=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# Enable only inside restricted Linux containers that cannot provide Chromium sandboxing.
ARGUS_BROWSER_NO_SANDBOX=false

# Safety / capacity ceilings. Scan-mode limits are capped by these values.
ARGUS_MAX_DISCOVERED_URLS=5000
ARGUS_MAX_LIGHT_PAGES=1200
ARGUS_MAX_DEEP_PAGES=220
ARGUS_LIGHT_CONCURRENCY=6

# Generic OpenAI-compatible AI adapter.
# Z.ai normal API example:
AI_PROVIDER=zai
AI_BASE_URL=https://api.z.ai/api/paas/v4
AI_ENDPOINT=/chat/completions
AI_API_STYLE=chat
AI_API_KEY=
AI_MODEL=
AI_AUTH_TYPE=bearer
AI_REQUIRE_KEY=true
AI_TEMPERATURE=0.15
AI_MAX_TOKENS=3600
AI_TIMEOUT=120000
AI_EXTRA_HEADERS=


# Optional same-origin application/database health correlation.
# ARGUS NEVER needs DB credentials and does not execute SQL.
# Point this to a safe GET endpoint on the scanned website, for example:
#   /api/argus-health
# Recommended response shape:
# {
#   "application": "ok",
#   "database": {
#     "connected": true,
#     "responseMs": 18,
#     "provider": "SQL Server",
#     "name": "app_db"
#   }
# }
# Do NOT expose connection strings, usernames, passwords, stack traces, or secrets.
ARGUS_HEALTH_PATH=
ARGUS_HEALTH_TIMEOUT=5000
ARGUS_DB_SLOW_MS=1000
